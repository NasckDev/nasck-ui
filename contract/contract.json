{
  "$comment": "Fonte unica do contrato do Nasck UI. React (props) e Angular (inputs/outputs) precisam expor exatamente estes nomes. O teste em contract/contract.test.ts compara os dois pacotes com este arquivo. Conteudo projetado (children / ng-content) nao entra aqui.",
  "icons": [
    "plus",
    "search",
    "delete",
    "edit",
    "download",
    "upload",
    "check",
    "close",
    "user",
    "setting",
    "bell",
    "info",
    "warning",
    "mail",
    "calendar",
    "filter",
    "reload",
    "more",
    "arrow-up",
    "arrow-down",
    "home",
    "eye"
  ],
  "components": {
    "AppThemeProvider": {
      "selector": "app-theme-provider",
      "props": ["preset", "mode", "density"],
      "events": {}
    },
    "AppButton": {
      "selector": "app-button",
      "props": ["variant", "size", "loading", "disabled", "icon", "danger", "block", "htmlType"],
      "events": { "onClick": "clicked" }
    },
    "AppIconButton": {
      "selector": "app-icon-button",
      "props": ["icon", "label", "variant", "size", "loading", "disabled", "danger"],
      "events": { "onClick": "clicked" }
    },
    "AppInput": {
      "selector": "app-input",
      "props": [
        "value",
        "type",
        "label",
        "placeholder",
        "hint",
        "errorMessage",
        "size",
        "disabled",
        "loading",
        "allowClear",
        "prefixIcon",
        "required"
      ],
      "events": { "onChange": "valueChange" }
    },
    "AppSelect": {
      "selector": "app-select",
      "props": [
        "value",
        "options",
        "placeholder",
        "label",
        "hint",
        "errorMessage",
        "size",
        "disabled",
        "loading",
        "searchable",
        "multiple",
        "allowClear",
        "emptyText"
      ],
      "events": { "onChange": "valueChange", "onSearch": "searched" }
    },
    "AppCheckbox": {
      "selector": "app-checkbox",
      "props": ["checked", "label", "disabled", "indeterminate", "errorMessage"],
      "events": { "onChange": "checkedChange" }
    },
    "AppSwitch": {
      "selector": "app-switch",
      "props": ["checked", "label", "disabled", "loading", "size"],
      "events": { "onChange": "checkedChange" }
    },
    "AppDatePicker": {
      "selector": "app-date-picker",
      "props": [
        "value",
        "label",
        "placeholder",
        "hint",
        "errorMessage",
        "size",
        "disabled",
        "allowClear"
      ],
      "events": { "onChange": "valueChange" }
    },
    "AppForm": {
      "selector": "app-form",
      "props": ["layout", "disabled", "size"],
      "events": { "onSubmit": "submitted" }
    },
    "AppFormItem": {
      "selector": "app-form-item",
      "props": ["label", "hint", "errorMessage", "required"],
      "events": {}
    },
    "AppTable": {
      "selector": "app-table",
      "props": [
        "columns",
        "data",
        "rowKey",
        "loading",
        "emptyText",
        "pageSize",
        "pagination",
        "size"
      ],
      "events": { "onRowClick": "rowClick" }
    },
    "AppCard": {
      "selector": "app-card",
      "props": ["title", "extra", "loading", "bordered", "hoverable", "size"],
      "events": {}
    },
    "AppStatistic": {
      "selector": "app-statistic",
      "props": ["title", "value", "prefix", "suffix", "precision", "loading", "trend"],
      "events": {}
    },
    "AppTag": {
      "selector": "app-tag",
      "props": ["label", "color", "icon", "closable", "bordered"],
      "events": { "onClose": "closed" }
    },
    "AppStatus": {
      "selector": "app-status",
      "props": ["status", "label"],
      "events": {}
    },
    "AppModal": {
      "selector": "app-modal",
      "props": ["open", "title", "okText", "cancelText", "loading", "danger", "width", "closable"],
      "events": { "onOk": "confirmed", "onCancel": "cancelled" }
    },
    "AppDrawer": {
      "selector": "app-drawer",
      "props": ["open", "title", "placement", "width", "closable"],
      "events": { "onClose": "closed" }
    },
    "AppTabs": {
      "selector": "app-tabs",
      "props": ["items", "activeKey", "type", "size"],
      "events": { "onChange": "activeKeyChange" }
    },
    "AppSteps": {
      "selector": "app-steps",
      "props": ["items", "current", "direction", "size"],
      "events": {}
    },
    "AppEmpty": {
      "selector": "app-empty",
      "props": ["title", "description", "actionLabel", "image"],
      "events": { "onAction": "action" }
    },
    "AppSkeleton": {
      "selector": "app-skeleton",
      "props": ["loading", "rows", "avatar", "title", "active"],
      "events": {}
    },
    "AppAlert": {
      "selector": "app-alert",
      "props": ["type", "title", "description", "closable", "showIcon", "banner"],
      "events": { "onClose": "closed" }
    },
    "AppTooltip": {
      "selector": "app-tooltip",
      "props": ["title", "placement"],
      "events": {}
    },
    "AppDropdown": {
      "selector": "app-dropdown",
      "props": ["items", "label", "trigger", "placement", "disabled", "icon"],
      "events": { "onSelect": "selected" }
    },
    "AppMenu": {
      "selector": "app-menu",
      "props": ["items", "selectedKey", "mode", "collapsed"],
      "events": { "onSelect": "selected" }
    },
    "AppAvatar": {
      "selector": "app-avatar",
      "props": ["src", "name", "size", "shape", "icon"],
      "events": {}
    },
    "AppPagination": {
      "selector": "app-pagination",
      "props": ["current", "total", "pageSize", "showSizeChanger", "simple", "disabled"],
      "events": { "onChange": "pageChange" }
    },
    "AppChart": {
      "selector": "app-chart",
      "props": [
        "type",
        "categories",
        "series",
        "title",
        "height",
        "loading",
        "emptyText",
        "ariaLabel",
        "valueFormat"
      ],
      "events": {}
    }
  }
}
