{
  "name": "@nasckdev/nasck-ui",
  "version": "0.1.0",
  "description": "Accessible Product Interface System: design tokens, accessible React components and a living-docs playground.",
  "license": "MIT",
  "author": "Alexandre Diogo Nascimento",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NasckDev/nasck-ui.git"
  },
  "homepage": "https://nasckdev.github.io/nasck-ui/",
  "keywords": [
    "react",
    "design-system",
    "accessibility",
    "a11y",
    "components",
    "design-tokens"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./playground/src/main.tsx"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/nasck-ui.css",
    "./tokens": {
      "types": "./dist/types/tokens/index.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:tokens && vite build && node scripts/copy-tokens-css.ts && tsc -p tsconfig.build.json",
    "build:tokens": "node scripts/build-tokens.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "playground": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "preview:playground": "vite preview --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
