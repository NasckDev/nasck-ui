{
  "name": "nasck-ui-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Nasck UI: biblioteca de wrappers de referencia sobre Ant Design (React) e NG-ZORRO (Angular), com tokens de tema compartilhados.",
  "license": "MIT",
  "author": "Alexandre Diogo Nascimento",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NasckDev/nasck-ui.git"
  },
  "homepage": "https://nasckdev.github.io/nasck-ui/",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:tokens": "npm run build -w @nasckdev/nasck-ui-tokens",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build:tokens && npm run typecheck -w @nasckdev/nasck-ui-react && npm run typecheck -w @nasckdev/nasck-ui-angular",
    "test": "npm run test:tokens && npm run test:react && npm run test:contract && npm run test:angular",
    "test:tokens": "npm run test -w @nasckdev/nasck-ui-tokens",
    "test:react": "npm run test -w @nasckdev/nasck-ui-react",
    "test:angular": "npm run test -w @nasckdev/nasck-ui-angular",
    "test:contract": "vitest run --config contract/vitest.config.ts --pool=threads --maxWorkers=1",
    "storybook:react": "npm run storybook -w @nasckdev/nasck-ui-react",
    "storybook:angular": "npm run storybook -w @nasckdev/nasck-ui-angular",
    "build-storybook": "npm run build-storybook -w @nasckdev/nasck-ui-react && npm run build-storybook -w @nasckdev/nasck-ui-angular",
    "build:portable": "node scripts/build-portable.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
